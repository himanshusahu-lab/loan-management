    {
        "id": "sd_5PXyyzw2y3eH0KBv",
        "type": "Script",
        "z": "SSD_SERVICE_ID_sd_KG0qewBWvAr9C52R",
        "viewType": "common",
        "nodeType": "flow",
        "name": "assignReviewTask",
        "script": "let assignedRole = null;\nlet reviewStage = null;\n\nif (bh.local.loanRequest.status === \"SUBMITTED\") {\n    bh.local.submittedAt =\n        new Date().toISOString();\n}\n\nswitch (bh.local.loanDecision) {\n\n    case \"AUTO_APPROVE\":\n\n        assignedRole = null;\n        reviewStage = null;\n\n        break;\n\n    case \"LOAN_OFFICER_REVIEW\":\n\n        assignedRole = \"LOAN_OFFICER\";\n        reviewStage =\n            \"LOAN_OFFICER_REVIEW\";\n\n        break;\n\n    case \"CREDIT_MANAGER_REVIEW\":\n\n        assignedRole = \"CREDIT_MANAGER\";\n        reviewStage =\n            \"CREDIT_MANAGER_REVIEW\";\n\n        break;\n\n    default:\n\n        assignedRole = \"CREDIT_MANAGER\";\n        reviewStage =\n            \"CREDIT_MANAGER_REVIEW\";\n}\n\nbh.local.assignedRole =\n    assignedRole;\n\nbh.local.reviewStage =\n    reviewStage;\n\nconsole.log({\n    assignedRole,\n    reviewStage,\n    submittedAt:\n        bh.local.submittedAt\n});",
        "functionName": "assignReviewTask",
        "category": "Function",
        "x": 885,
