        "name": "validateRequest",
        "script": "let loanId =\n    bh.input.params.id;\n\nlet body =\n    bh.input.body;\n\n\nif (!loanId) {\n\n    throw {\n        statusCode: 400,\n        message:\n            \"Loan ID required\"\n    };\n}\n\n\nif (!body.action) {\n\n    throw {\n        statusCode: 400,\n        message:\n            \"Action required\"\n    };\n}\n\n\nbh.local.loanId =\n    Number(loanId);\n\nbh.local.body =\n    body;",
