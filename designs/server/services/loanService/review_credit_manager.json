        "z": "SSD_SERVICE_ID_sd_YYpEzCx9fwcVc5u8",
        "viewType": "common",
        "nodeType": "flow",
        "name": "validateLoanStatus",
        "script": "let loan =\n    bh.local.loanData;\n\n\nconsole.log(\n    \"loan >>>>\",\n    loan\n);\nif (\n    Array.isArray(loan)\n) {\n\n    loan = loan[0];\n}\n\n\n\nif (!loan) {\n\n    throw {\n        statusCode: 404,\n        message:\n            \"Loan not found\"\n    };\n}\n\n\nif (\n    loan.status !==\n    \"CREDIT_MANAGER_REVIEW\"\n) {\n\n    throw {\n        statusCode: 400,\n        message:\n            \"Loan is not in credit manager review state\"\n    };\n}",
        "functionName": "validateLoanStatus",
