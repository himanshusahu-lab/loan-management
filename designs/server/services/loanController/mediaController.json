        "script": "const uploadedFile =\n    bh.local.uploadedFile;\n\nif (!uploadedFile) {\n\n    bh.input.error = {\n\n        statusCode: 400,\n\n        message:\n            \"Uploaded file missing\"\n    };\n\n    throw new Error(\n        \"Uploaded file missing\"\n    );\n}\n\nconst fileName =\n    `${Date.now()}_${uploadedFile.originalname}`;\n\nconst filePath =\n    `./uploads/${fileName}`;\n\nbh.local.fileName =\n    fileName;\n\nbh.local.filePath =\n    filePath;\n\nbh.local.fileBuffer =\n    uploadedFile.buffer;\n\nconsole.log(\n    \"FILE NAME:\",\n    fileName\n);\n\nconsole.log(\n    \"FILE PATH:\",\n    filePath\n);",
